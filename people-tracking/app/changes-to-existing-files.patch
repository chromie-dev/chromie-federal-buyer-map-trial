+test("get_person carries dated posts and moves inside the size budget", async () => {
+  const offices = Array.from({ length: 30 }, (_, index) => ({
+    id: `org-${index}`,
+    name: `Example Contracting Office ${index}`,
+    org_type: "contracting_office",
+  }))
+  const tables = personTables({
+    gov_organizations: offices,
+    gov_contact_positions: offices.map((office, index) => ({
+      id: `post-${index}`,
+      contact_id: CONTACT_ID,
+      organization_id: office.id,
+      role_type: "contract_specialist",
+      raw_title: null,
+      valid_from: index === 0 ? "2025-05-01" : null,
+      valid_to: index === 0 ? null : `2024-${String((index % 12) + 1).padStart(2, "0")}-10`,
+      date_basis: index === 0 ? "stated" : "observed",
+      first_observed_at: "2023-01-10T00:00:00Z",
+      // The biography was read a month ago, so the post stays confirmed whenever the test runs.
+      last_observed_at: index === 0 ? new Date(Date.now() - 30 * 86_400_000).toISOString() : "2026-08-01T00:00:00Z",
+      // FPDS only observes; a stated start comes from an official biography.
+      source: index === 0 ? "bio_pages" : "fpds_staff",
+      source_url: `https://www.fpds.gov/${index}`,
+    })),
+    gov_contact_role_history: offices.map((office, index) => ({
+      id: `move-${index}`,
+      gov_contact_id: CONTACT_ID,
+      event_type: "transfer",
+      title: `Contract Specialist, ${office.name}`,
+      previous_title: null,
+      effective_date: `2025-${String((index % 12) + 1).padStart(2, "0")}-10`,
+      date_basis: "observed",
+      status: index === 1 ? "retracted" : "current",
+      source_provider: "fpds_staff",
+      source_url: `https://www.fpds.gov/move/${index}`,
+      organization_id: office.id,
+      previous_organization_id: offices[(index + 1) % offices.length].id,
+      evidence: [{ office_code: "X", raw_source_record: "must not escape" }],
+    })),
+  })
+  const result = await execute("get_person", { person_id: `contact:${CONTACT_ID}` }, context(tables))
+  assert.equal(result.status, "ready")
+  const { history } = result.data
+  assert.equal(history.truncated, true)
+  assert.ok(history.posts.length > 0 && history.moves.length > 0)
+  assert.deepEqual(
+    { started: history.posts[0].started, date_basis: history.posts[0].date_basis, current: history.posts[0].current },
+    { started: "2025-05-01", date_basis: "stated", current: true },
+  )
+  assert.match(history.posts[0].standing, /^Confirmed current as of \d{4}-\d{2}-\d{2} \(Official biography\)$/u)
+  assert.match(history.posts[1].standing, /^Last observed here 2024-/u)
+  assert.match(history.moves[0].certainty, /^Inferred move/u)
+  assert.equal(history.posts[1].date_basis, "observed")
+  assert.equal(history.posts[1].started, null)
+  assert.ok(!history.moves.some((move) => move.source_url.endsWith("/move/1")))
+  assert.doesNotMatch(JSON.stringify(result), /raw_source_record|identity_key|prediction_signals/u)
+  assert.ok(JSON.stringify(result).length < 11000)
+})
