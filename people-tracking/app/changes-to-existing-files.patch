+    previous_title: clipText(move.previous_title, 160) || null,
+    date: move.date,
+    date_basis: move.basis,
+    // confirmed (an official source states it), reported (a licensed profile does) or inferred (two records imply it).
+    certainty: move.certainty_label,
+    status: move.status,
+    source: move.source_label,
+    source_url: clipText(move.source_url, 300) || null,
+  }
+}
+
+async function loadHistory(ctx, contactId) {
+  if (!contactId) return { history: null }
+  const [positions, moves] = await Promise.all([
+    ctx.client
+      .from("gov_contact_positions")
+      .select("id,organization_id,role_type,raw_title,valid_from,valid_to,date_basis,first_observed_at,last_observed_at,source,source_url")
+      .eq("contact_id", contactId)
+      .limit(MAX_HISTORY_ROWS),
+    ctx.client
+      .from("gov_contact_role_history")
+      .select("id,event_type,title,previous_title,effective_date,date_basis,status,source_provider,source_url,organization_id,previous_organization_id")
+      .eq("gov_contact_id", contactId)
+      .order("effective_date", { ascending: false })
+      .limit(MAX_HISTORY_ROWS),
+  ])
+  for (const result of [positions, moves]) {
+    if (result.error && !isMissingSchemaError(result.error)) {
+      return { error: failed(`Person history lookup failed: ${result.error.message}`) }
+    }
+  }
+  const organizationIds = [
+    ...new Set(
+      [...(positions.data || []), ...(moves.data || [])]
+        .flatMap((row) => [row.organization_id, row.previous_organization_id])
+        .filter(Boolean),
+    ),
+  ]
+  const organizations = organizationIds.length
+    ? await ctx.client.from("gov_organizations").select("id,name,org_type").in("id", organizationIds)
+    : { data: [], error: null }
+  if (organizations.error && !isMissingSchemaError(organizations.error)) {
+    return { error: failed(`Person history lookup failed: ${organizations.error.message}`) }
+  }
+  const timeline = personTimeline({
+    positions: positions.data || [],
+    moves: moves.data || [],
+    organizations: organizations.data || [],
+  })
+  const postRows = timeline.posts.map(projectPost)
+  const moveRows = timeline.moves.map(projectMove)
+  const selectedMoves = takeWithinBudget(moveRows, HISTORY_CHAR_BUDGET / 2)
+  const selectedPosts = takeWithinBudget(postRows, HISTORY_CHAR_BUDGET / 2)
+  return {
+    history: {
+      posts: selectedPosts,
+      moves: selectedMoves,
+      truncated: selectedPosts.length < postRows.length || selectedMoves.length < moveRows.length,
+    },
+  }
+}
