+def build_person_moved_email(
+    notification: dict[str, Any],
+    *,
+    app_url: str | None = None,
+) -> dict[str, str]:
+    """A tracked person changed post: the move, how sure it is, its date and basis, and a link to their timeline."""
+    payload = _object(notification.get("payload"))
+    heading = {"confirmed": "Tracked person: confirmed move", "reported": "Tracked person: reported move",
+               "inferred": "Tracked person: inferred move"}.get(str(payload.get("certainty")), "Tracked person moved")
+    subject = str(notification.get("title") or "A person you track changed post")
+    body = str(notification.get("body") or "")
+    base_url = (app_url or digest_app_url()).rstrip("/")
+    # The directory names a person by "contact:<id>".
+    url = f"{base_url}/contractors/directory?person=contact%3A{payload.get('contact_id') or ''}"
+    source_url = str(payload.get("source_url") or "")
+    source_link = (
+        f'<p style="margin:10px 0 0;font-size:13px"><a href="{html.escape(source_url)}" style="color:#2563eb">Source record</a></p>'
+        if source_url.startswith(("http://", "https://"))
+        else ""
+    )
+    html_body = f"""<!DOCTYPE html>
+<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{html.escape(subject)}</title></head>
+<body style="margin:0;padding:32px 16px;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#18181b">
+  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:560px;margin:0 auto">
+    <tr><td style="padding:0 4px 16px"><strong>chromie</strong><span style="color:#a1a1aa">.dev</span></td></tr>
+    <tr><td style="padding:28px 32px;background:#fff;border:1px solid #e4e4e7;border-radius:8px">
+      <p style="margin:0 0 8px;font-size:13px;font-weight:600;color:#2563eb">{html.escape(heading)}</p>
+      <h1 style="margin:0;font-size:19px;line-height:1.4">{html.escape(subject)}</h1>
+      <p style="margin:10px 0 0;color:#52525b;font-size:14px">{html.escape(body)}</p>
+      {source_link}
+      <table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0 0"><tr><td style="border-radius:6px;background:#18181b"><a href="{html.escape(url)}" style="display:inline-block;padding:10px 20px;color:#fff;text-decoration:none;font-size:14px;font-weight:600">Open timeline</a></td></tr></table>
+    </td></tr>
+  </table>
+</body></html>"""
+    text_lines = [heading, subject, "", body]
+    if source_link:
+        text_lines.append(f"Source record: {source_url}")
+    text_lines.extend(["", f"Open timeline: {url}"])
+    return {"subject": subject, "html": html_body, "text": "\n".join(text_lines)}
+
